# Server
NODE_ENV=production
PORT=4000
APP_URL=http://localhost:4000

# Database — PostgreSQL (shared, production ready)
# If using docker-compose.yml, this is set automatically inside the container.
DATABASE_URL="postgresql://triptale:triptale_dev_pw@localhost:5432/triptale?schema=public"

# JWT
JWT_ACCESS_SECRET=triptale-access-7a3e9c2b4d5f6a8e1c9d7b6a5f4e3d2c
JWT_REFRESH_SECRET=triptale-refresh-9d8e7f6c5b4a3e2d1c0b9a8f7e6d5c4b
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=20

# CORS
CORS_ORIGIN=*
